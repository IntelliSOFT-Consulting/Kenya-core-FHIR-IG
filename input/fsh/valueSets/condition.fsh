ValueSet: ConditionCategoryVS
Title: "Condition Category Value Set"
Description: "A value set that includes categories for conditions."
* ^experimental = false
* include codes from system ConditionCategoryCS

ValueSet: ConditionVerificationStatusVS
Title: "Condition Verification Status Value Set"
Description: "A value set that includes verification status codes for conditions."
* ^experimental = false
* include codes from system http://terminology.hl7.org/CodeSystem/condition-ver-status

ValueSet: ConditionClinicalStatusVS
Title: "Condition Clinical Status Value Set"
Description: "A value set that includes clinical status codes for conditions."
* ^experimental = false
* include codes from system http://terminology.hl7.org/CodeSystem/condition-clinical